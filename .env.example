# Enterprise AI Modernization Architect — Environment Configuration
# Copy to .env and adjust for local development.
# NEVER commit real secrets.

# Application
AIMA_APP_NAME=Enterprise AI Modernization Architect
AIMA_ENVIRONMENT=local
AIMA_DEBUG=true
AIMA_LOG_LEVEL=INFO
AIMA_LOG_FORMAT=json

# API
AIMA_API_HOST=0.0.0.0
AIMA_API_PORT=8000
AIMA_API_PREFIX=/api/v1

# Database (local Docker Compose defaults)
AIMA_DATABASE_URL=postgresql+psycopg://aima:aima@localhost:5432/aima
AIMA_DATABASE_POOL_SIZE=5
AIMA_DATABASE_MAX_OVERFLOW=10

# Object storage abstraction (local filesystem for Stage 1)
AIMA_STORAGE_BACKEND=filesystem
AIMA_STORAGE_PATH=./data/processed

# LLM abstraction (not required for Stage 1; stub for later stages)
AIMA_LLM_PROVIDER=openai_compatible
AIMA_LLM_BASE_URL=http://localhost:11434/v1
AIMA_LLM_API_KEY=
AIMA_LLM_MODEL=gpt-4o-mini
AIMA_EMBEDDING_MODEL=text-embedding-3-small

# Observability
AIMA_OTEL_ENABLED=false
AIMA_SERVICE_NAME=aima-api
